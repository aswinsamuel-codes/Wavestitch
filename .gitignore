testing audio/

# App build output, dependencies and local app data (library DB, AI models, stems, logs)
app/node_modules/
app/out/
app/dist/
app/.dev-data/
app/models/

# OS / editor clutter
.DS_Store
Thumbs.db
desktop.ini
*.log
